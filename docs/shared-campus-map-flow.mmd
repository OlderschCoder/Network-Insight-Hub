flowchart LR
    C[CIO Mark or Tracy] --> E[Buildings map editor]
    E -->|PUT built-in and custom positions plus visibility| V[Validate marker code up to 200 chars]
    V --> A[/Canonical map-layout API/]
    A --> D[(Position rows)]
    A --> H[(Hidden-marker metadata rows)]
    D --> A
    H --> A
    L[(Legacy building-hidden rows)] -->|translate name to overlay code| A
    A -->|GET no-store| B[Buildings CampusStatusMap]
    A -->|GET no-store once, share loaded layout| M[Monitoring map, green count, and overall status]
    S[Fresh switch evidence<br/>NOC first, Influx up to 90 seconds] --> HP{Building health policy}
    P[Complete Webex physical-phone evidence] --> HP
    K[(Enabled explicit main-switch designation<br/>disabled candidates ignored)] --> HP
    HP --> PS[/Public-safe status projection/]
    HP --> AE[/Authenticated operational evidence/]
    PS -->|Green all switches up| B
    PS -->|Amber partial or incomplete| B
    PS -->|Red main switch and phones down| B
    PS --> M
    E -. save/reset event .-> B
    E -. same-tab or cross-tab refresh .-> M
    T[Focus, visibility, and 30-second refresh] -.-> B
    T -.-> M

    classDef editor fill:#eff6ff,stroke:#2563eb,color:#1e3a8a;
    classDef source fill:#ecfdf5,stroke:#16a34a,color:#14532d;
    classDef consumer fill:#f8fafc,stroke:#475569,color:#0f172a;
    class C,E editor;
    class A,D,H,L,V source;
    class B,M,T consumer;
