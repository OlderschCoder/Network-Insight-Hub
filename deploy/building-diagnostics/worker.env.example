# Root-owned 0600, readable only by the service through systemd EnvironmentFile.
# Fred's public origin, not private 10.0.0.22. No path, query, or credentials.
BUILDING_DIAGNOSTICS_FRED_ORIGIN=https://fred.example.invalid
# Generate a new dedicated random credential; configure the same on Fred.
# Never reuse NOC_PROBE_TOKEN, emergency alert tokens, or an administrator token.
BUILDING_DIAGNOSTICS_WORKER_TOKEN=REPLACE_WITH_A_DEDICATED_RANDOM_CREDENTIAL
