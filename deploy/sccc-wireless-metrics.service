[Unit]
Description=SCCC Aruba wireless metrics collector
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/docker run --rm --name sccc-wireless-metrics --network host --env-file /etc/sccc-wireless-metrics.env -v /etc/sccc-wireless-metrics/known_hosts:/etc/sccc-wireless-metrics/known_hosts:ro -v /var/lib/sccc-wireless-metrics:/var/lib/sccc-wireless-metrics sccc-wireless-metrics:1.0
StateDirectory=sccc-wireless-metrics
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
